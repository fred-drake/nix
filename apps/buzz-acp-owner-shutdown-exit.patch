+async fn handle_authenticated_owner_shutdown(
+    event: &nostr::Event,
+    kind_u32: u32,
+    agent_pubkey_hex: &str,
+    owner_pubkey_hex: Option<&str>,
+    owner_shutdown_requested: &mut bool,
+    shutdown_tx: &watch::Sender<()>,
+) -> bool {
+    if !is_owner_control_command(event, kind_u32, "!shutdown", agent_pubkey_hex)
+        || !owner_pubkey_hex.is_some_and(|owner| event.pubkey.to_hex() == owner)
+    {
+        return false;
+    }
+
+    let event_to_verify = event.clone();
+    match tokio::task::spawn_blocking(move || buzz_core::verify_event(&event_to_verify)).await {
+        Ok(Ok(())) => {}
+        Ok(Err(error)) => {
+            tracing::warn!(error = %error, "owner shutdown event failed cryptographic verification");
+            return false;
+        }
+        Err(error) => {
+            tracing::warn!(error = %error, "owner shutdown verification task failed");
+            return false;
+        }
+    }
+
+    *owner_shutdown_requested = true;
+    let _ = shutdown_tx.send(());
+    true
+}
