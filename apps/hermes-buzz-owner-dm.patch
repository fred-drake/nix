+def _normalize_dm_members(value: Any) -> Optional[Tuple[Tuple[str, str], ...]]:
+    """Return two unique normalized (pubkey, role) pairs or fail closed."""
+    if not isinstance(value, list) or len(value) != 2:
+        return None
+    members = []
+    seen = set()
+    for item in value:
+        if not isinstance(item, dict):
+            return None
+        pubkey = _normalize_user_ref(item.get("pubkey"))
+        role = item.get("role")
+        if pubkey is None or not isinstance(role, str) or role != "member" or pubkey in seen:
+            return None
+        seen.add(pubkey)
+        members.append((pubkey, role))
+    return tuple(sorted(members))
+
