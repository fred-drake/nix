+def _is_verified_owner_dm(
+    channel_id: str,
+    metadata: Optional[dict],
+    event: dict,
+    self_pubkey: str,
+    allowed_pubkeys: set,
+) -> bool:
+    """Pure authoritative one-to-one owner-DM predicate."""
+    if not isinstance(metadata, dict):
+        return False
+    if metadata.get("_relay_channel_type") != "dm":
+        return False
+    if metadata.get("_relay_visibility") != "private":
+        return False
+
+    members = metadata.get("_relay_dm_members")
+    if not isinstance(members, tuple) or len(members) != 2:
+        return False
+    normalized_members = []
+    for member in members:
+        if not isinstance(member, tuple) or len(member) != 2:
+            return False
+        pubkey = _normalize_user_ref(member[0])
+        if pubkey is None or member[1] != "member" or pubkey != member[0]:
+            return False
+        normalized_members.append(pubkey)
+    if len(set(normalized_members)) != 2:
+        return False
+
+    normalized_self = _normalize_user_ref(self_pubkey)
+    normalized_allowed = {
+        pubkey
+        for value in allowed_pubkeys
+        if isinstance(value, str) and (pubkey := _normalize_user_ref(value))
+    }
+    if normalized_self is None or normalized_self not in normalized_members or not normalized_allowed:
+        return False
+    other_members = set(normalized_members) - {normalized_self}
+    if len(other_members) != 1:
+        return False
+    owner = next(iter(other_members))
+    if owner not in normalized_allowed:
+        return False
+
+    if int(event.get("kind") or 0) != _CHAT_KIND:
+        return False
+    author = _normalize_user_ref(event.get("pubkey"))
+    if author != owner or author == normalized_self:
+        return False
+    tags = event.get("tags")
+    if not isinstance(tags, list):
+        return False
+    channel_tags = [
+        tag for tag in tags
+        if isinstance(tag, (list, tuple)) and tag and tag[0] == "h"
+    ]
+    return (
+        len(channel_tags) == 1
+        and len(channel_tags[0]) == 2
+        and str(channel_tags[0][1]) == channel_id
+    )
+
